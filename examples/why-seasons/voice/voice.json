{
  "voice": {
    "voice_id": "1FmDfZG0Nx2dCk793S1a",
    "name": "Megan",
    "model": "eleven_multilingual_v2",
    "language": "en"
  },
  "lines": {
    "s02": {
      "text": "Is summer when we're closer to the Sun?",
      "sha": "c57ae92af43a8557",
      "file": "s02.mp3",
      "duration": 2.116,
      "lead": 0,
      "tail": 0.379,
      "speech": 1.737
    },
    "s01": {
      "text": "Why do we have seasons?",
      "sha": "a6a642953471ca78",
      "file": "s01.mp3",
      "duration": 1.437,
      "lead": 0.074,
      "tail": 0.411,
      "speech": 0.952
    },
    "s03": {
      "text": "No. We're closest in early January,",
      "sha": "ac68b073dc263efb",
      "file": "s03.mp3",
      "duration": 2.403,
      "lead": 0.053,
      "tail": 0.353,
      "speech": 1.997
    },
    "s04": {
      "text": "in the northern winter.",
      "sha": "2878834acea51599",
      "file": "s04.mp3",
      "duration": 1.384,
      "lead": 0.059,
      "tail": 0.36,
      "speech": 0.966
    },
    "s05": {
      "text": "The real cause is the tilt.",
      "sha": "699e729a69668cbf",
      "file": "s05.mp3",
      "duration": 1.698,
      "lead": 0.112,
      "tail": 0.395,
      "speech": 1.191
    },
    "s06": {
      "text": "Earth's axis leans twenty-three point four degrees,",
      "sha": "c96ed5282b3c0c6f",
      "file": "s06.mp3",
      "duration": 2.873,
      "lead": 0.053,
      "tail": 0.361,
      "speech": 2.46
    },
    "s07": {
      "text": "and points the same way all year.",
      "sha": "d6b892d6cacf7466",
      "file": "s07.mp3",
      "duration": 1.802,
      "lead": 0,
      "tail": 0.36,
      "speech": 1.443
    },
    "s08": {
      "text": "In June, the north leans toward the Sun.",
      "sha": "a48d60634478c1e2",
      "file": "s08.mp3",
      "duration": 2.325,
      "lead": 0.061,
      "tail": 0.403,
      "speech": 1.86
    },
    "s09": {
      "text": "Steep sunlight is packed into a small patch.",
      "sha": "ccc7d9a6535a89a7",
      "file": "s09.mp3",
      "duration": 2.534,
      "lead": 0.052,
      "tail": 0.329,
      "speech": 2.152
    },
    "s10": {
      "text": "In December, the north leans away.",
      "sha": "f92464431c8f6b1c",
      "file": "s10.mp3",
      "duration": 2.038,
      "lead": 0.059,
      "tail": 0.368,
      "speech": 1.611
    },
    "s11": {
      "text": "The same beam, now low, covers twice the ground.",
      "sha": "1a62f3e54826f984",
      "file": "s11.mp3",
      "duration": 2.952,
      "lead": 0.109,
      "tail": 0.367,
      "speech": 2.476
    },
    "s12": {
      "text": "Days are longer too: fifteen hours against nine.",
      "sha": "250e4928629abad7",
      "file": "s12.mp3",
      "duration": 2.926,
      "lead": 0.077,
      "tail": 0.396,
      "speech": 2.453
    },
    "s13": {
      "text": "Steep light and long days: that's summer.",
      "sha": "8a5ca13d26e9a69e",
      "file": "s13.mp3",
      "duration": 2.403,
      "lead": 0,
      "tail": 0.392,
      "speech": 2.011
    },
    "s14": {
      "text": "It's the tilt, not the distance.",
      "sha": "57daa30c55dab538",
      "file": "s14.mp3",
      "duration": 2.09,
      "lead": 0.063,
      "tail": 0.398,
      "speech": 1.629
    }
  }
}
